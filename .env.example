# Every key is optional. A client with none still serves the 51 titles whose
# providers need no credential - Dota 2, Age of Empires IV, StarCraft II,
# Warcraft III, Overwatch 2, chess, Beat Saber and the Liquipedia-backed rest.
#
# `client.diagnostics()` tells you which of these would unlock the most titles
# next, so start there rather than collecting all of them.

# --- first-party -----------------------------------------------------------
STEAM_API_KEY=              # steamcommunity.com/dev/apikey
RIOT_API_KEY=               # developer.riotgames.com  (dev keys expire daily)
BLIZZARD_CLIENT=            # clientId:clientSecret  - develop.battle.net
BUNGIE_API_KEY=             # bungie.net/en/Application
PUBG_API_KEY=               # developer.pubg.com      (10 requests/minute)
CLASH_ROYALE_TOKEN=         # developer.clashroyale.com   - IP-bound
CLASH_OF_CLANS_TOKEN=       # developer.clashofclans.com  - IP-bound
BRAWL_STARS_TOKEN=          # developer.brawlstars.com    - IP-bound
WARGAMING_APP_ID=           # developers.wargaming.net
HIREZ_KEY=                  # devId:authKey - hirezstudios.com/developers
IRACING_LOGIN=              # email:password
OSU_CLIENT=                 # clientId:clientSecret
HYPIXEL_API_KEY=
BRAWLHALLA_API_KEY=
GUILDWARS2_TOKEN=           # needs the `pvp` scope

# --- community -------------------------------------------------------------
FACEIT_API_KEY=             # server-side key, not a client one
TRACKER_API_KEY=            # tracker.gg/developers - R6, CoD, Battlefield
HENRIKDEV_KEY=              # VALORANT without an approved Riot production key
APEX_API_KEY=               # apexlegendsapi.com
FORTNITE_API_KEY=           # dash.fortnite-api.com
HALO_API_KEY=
BALLCHASING_TOKEN=
STRATZ_TOKEN=
MARVEL_RIVALS_KEY=
HEROESPROFILE_TOKEN=
TRACKMANIA_KEY=
OPENDOTA_API_KEY=           # optional - raises the quota
LICHESS_TOKEN=              # optional - most endpoints are open

# --- esports ---------------------------------------------------------------
PANDASCORE_TOKEN=           # the broadest fixture source
ABIOS_CLIENT=               # clientId:secret
STARTGG_TOKEN=              # the fighting-game circuit
TOORNAMENT_KEY=             # apiKey:clientId:clientSecret
CHALLONGE_API_KEY=
ESPORTS_EARNINGS_KEY=       # prize money - 1 request/second, enforced

# --- optional infrastructure ----------------------------------------------
REDIS_HOST=                 # leave empty to use the in-memory cache
