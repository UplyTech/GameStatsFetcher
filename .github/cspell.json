    "**/*.pyc"
  ],
  "ignorePaths": [
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.venv/**",
    "**/coverage/**",
    "**/*.lock",
    "**/package-lock.json",
    ".github/cspell-registry.txt",
    ".github/cspell-vocabulary.txt"
  ],
  "ignoreRegExpList": [
    "/[0-9a-fA-F]{7,}/g",
    "/https?:\\/\\/[^\\s)]+/g",
    "/`[^`]*`/g",
    "/\\b[a-z]+[A-Z][a-zA-Z]*\\b/g"
  ],
  "dictionaryDefinitions": [
    {
      "name": "gsf-registry",
      "path": "./cspell-registry.txt",
      "description": "Generated from shared/registry - see generate-cspell-registry.mjs"
    },
    {
      "name": "gsf-vocabulary",
      "path": "./cspell-vocabulary.txt",
      "description": "Hand-maintained: upstream field names, proper nouns, deliberate typos"
    }
  ],
