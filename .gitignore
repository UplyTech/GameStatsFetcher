# Node
node_modules/
# typescript/package-lock.json is committed on purpose: CI installs with
# `npm ci`, which needs it, and a library whose contributors resolve different
# dev-tool versions is a library whose "eslint clean" means different things to
# different people.
typescript/dist/
coverage/
*.tgz
.tsup/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Secrets. Every provider in this package needs a key; none of them belong here.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
python/.venv/
python/build/
python/dist/
python/*.egg-info/
python/.pytest_cache/
python/.mypy_cache/
python/.ruff_cache/
python/.coverage
python/htmlcov/

# generated copies of the repository-root files (kept so the published artefact carries them)
typescript/LICENSE
typescript/NOTICE
typescript/CHANGELOG.md
python/LICENSE
python/NOTICE
python/CHANGELOG.md

# Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# CI scratch space and release staging (own-runner workflows)
.ci-tmp/
release/
release-notes.md
scorecard.json
